{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blueprint",
  "version": "0.1.0",
  "identifier": "com.ethereumdegen.blueprint",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blueprint",
        "width": 1500,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["bp"],
        "name": "Blueprint",
        "description": "Infrastructure blueprint",
        "role": "Editor"
      }
    ]
  }
}
